# Copy to .env at the repo root; docker compose reads it.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=redaction
POSTGRES_USER=redaction
POSTGRES_PASSWORD=redaction
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8007
BACKEND_PORT=8007

FRONTEND_URL=http://localhost:3007
CORS_ALLOWED_ORIGINS=http://localhost:3007

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=3007
# Where the browser reaches the API (inlined into the client bundle at build).
NEXT_PUBLIC_API_URL=http://localhost:8007
# Where the Next.js server reaches the API (service name inside Compose).
API_INTERNAL_URL=http://backend:8007
AUTH_URL=http://localhost:3007
# NextAuth cookie/JWT signing key: `openssl rand -base64 32`.
AUTH_SECRET=change-me
