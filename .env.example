# Copy to .env at the repo root; docker compose reads it.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=redaction
POSTGRES_USER=redaction
POSTGRES_PASSWORD=redaction
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8007
BACKEND_PORT=8007

FRONTEND_URL=http://localhost:3007
CORS_ALLOWED_ORIGINS=http://localhost:3007

# Where a browser fetches uploaded screenshots from. Absolute and on the API's
# own host: the site is a different origin and hosts none of them. Required in
# production, where a wrong value is a page of broken images rather than an
# error - https://backend.redaction-tools.com/media.
PUBLIC_MEDIA_URL=http://localhost:8007/media

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email through Brevo's HTTP API (production compose only). Unset,
# production falls back to the EMAIL_* SMTP relay. DEFAULT_FROM_EMAIL must be a
# sender or domain verified in Brevo.
BREVO_API_KEY=

# --- Database backups (production compose only) ---------------------------
# The db-backup service pg_dumps to S3 on a cron schedule (UTC) and deletes
# backups older than KEEP_DAYS. Leave ENDPOINT empty for AWS; set it for any
# S3-compatible store (MinIO, R2, ...). Without a bucket and keys the service
# stops with an error and the rest of the stack runs unaffected.
POSTGRES_BACKUP_S3_BUCKET=
POSTGRES_BACKUP_S3_FOLDER=redaction-tools
POSTGRES_BACKUP_S3_ENDPOINT=
POSTGRES_BACKUP_AWS_ACCESS_KEY_ID=
POSTGRES_BACKUP_AWS_SECRET_ACCESS_KEY=
POSTGRES_BACKUP_SCHEDULE=0 2 * * *
# pigz, gzip or zstd.
POSTGRES_BACKUP_COMPRESSION=pigz
POSTGRES_BACKUP_RUN_ON_STARTUP=false
POSTGRES_BACKUP_INCLUDE_HOSTNAME=false
POSTGRES_BACKUP_KEEP_DAYS=30

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=3007
# Where the browser reaches the API (inlined into the client bundle at build).
NEXT_PUBLIC_API_URL=http://localhost:8007
# Where the Next.js server reaches the API (service name inside Compose).
API_INTERNAL_URL=http://backend:8007
AUTH_URL=http://localhost:3007
# NextAuth cookie/JWT signing key: `openssl rand -base64 32`.
AUTH_SECRET=change-me
