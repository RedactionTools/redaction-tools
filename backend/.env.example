# Copy to backend/.env for running Django outside Docker (uv run manage.py ...).
# The Docker Compose stack reads the repo-root .env instead.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-generate-with-manage.py-generate-secret-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8007
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://redaction:redaction@localhost:5432/redaction

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:3007
CORS_ALLOWED_ORIGINS=http://localhost:3007

# --- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web).
# Authorized redirect URIs: http://localhost:8007/accounts/google/login/callback/  (allauth)
#                           http://localhost:3007/api/auth/callback/google        (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT ------------------------------------------------------------------
# Lifetimes in seconds. JWT_SIGNING_KEY is optional: unset means "sign with
# SECRET_KEY". Set it to rotate API tokens without invalidating sessions.
# JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=1209600

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@redaction-tools.com
# Used by config.settings.production only (SMTP relay / listmonk):
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Catalog --------------------------------------------------------------
# Hosts the SSRF guard refuses outright (compose service names, loopback).
CATALOG_BLOCKED_HOSTS=localhost,backend,db,qcluster,frontend
