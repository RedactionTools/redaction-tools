<mjml lang="en">
  <mj-head>
    <mj-title>You're subscribed to Redaction Tools updates</mj-title>
    <mj-preview>We'll write when there is a new review, tool or benchmark.</mj-preview>
    <mj-include path="../_partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f4f5" width="624px">
    <mj-include path="../_partials/header.mjml" />
    <mj-section padding="0 32px" background-color="#f4f4f5">
      <mj-column background-color="#ffffff" padding="32px 32px 16px">
        <mj-text>Hi,</mj-text>
        <mj-text padding="0 0 8px">Thanks for confirming - you're on the Redaction Tools list. We'll write when there is something new in:</mj-text>
        <mj-text>
          <ul style="margin:0;padding-left:20px;">
            {% for topic in topics %}<li style="margin-bottom:4px;">{{ topic }}</li>{% endfor %}
          </ul>
        </mj-text>
        <mj-text>No fixed schedule and no filler: a mail only goes out when we publish something.</mj-text>
        <mj-text padding="0 0 8px">While you wait:</mj-text>
        <mj-text>
          <ul style="margin:0;padding-left:20px;">
            <li style="margin-bottom:8px;"><a href="{{ site_url }}/" style="color:#18181b;">Compare tools</a> by price, detection method and deployment.</li>
            <li style="margin-bottom:8px;"><a href="{{ site_url }}/benchmarks" style="color:#18181b;">See the benchmarks</a>: how many sensitive values each tool leaves recoverable.</li>
            <li><a href="{{ site_url }}/blog" style="color:#18181b;">Read the reviews</a> on the blog.</li>
          </ul>
        </mj-text>
        <mj-button href="{{ site_url }}/" background-color="#18181b" color="#ffffff" font-size="15px" border-radius="6px" align="left" padding="8px 0 16px">Browse the catalog</mj-button>
        <mj-text font-size="13px" color="#71717a">Changed your mind? <a href="{{ unsubscribe_url }}" style="color:#71717a;">Unsubscribe</a> in one click.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="../_partials/footer.mjml" />
  </mj-body>
</mjml>
