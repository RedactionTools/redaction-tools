<mjml lang="en">
  <mj-head>
    <mj-title>{{ author_name }} replied to your comment on {{ page_title }}</mj-title>
    <mj-preview>{{ author_name }} replied to your comment on {{ page_title }}.</mj-preview>
    <mj-include path="../_partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f4f5" width="624px">
    <mj-include path="../_partials/header.mjml" />
    <mj-section padding="0 32px" background-color="#f4f4f5">
      <mj-column background-color="#ffffff" padding="32px 32px 16px">
        <mj-text><strong>{{ author_name }}</strong> replied to your comment on {{ page_title }}.</mj-text>
        <mj-text color="#71717a" padding-bottom="0"><strong>You wrote</strong></mj-text>
        <mj-text color="#71717a">{{ parent_excerpt|linebreaksbr }}</mj-text>
        <mj-text padding-bottom="0"><strong>{{ author_name }} replied</strong></mj-text>
        <mj-text>{{ comment_excerpt|linebreaksbr }}</mj-text>
        <mj-button href="{{ comment_url }}" background-color="#18181b" color="#ffffff" font-size="15px" border-radius="6px" align="left" padding="8px 0 16px">Read the thread</mj-button>
      </mj-column>
    </mj-section>
    <mj-include path="../_partials/footer.mjml" />
  </mj-body>
</mjml>
