<mjml lang="en">
  <mj-head>
    <mj-title>Sign in to Redaction Tools</mj-title>
    <mj-preview>Your sign-in code is {{ code }}</mj-preview>
    <mj-include path="../_partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f4f5" width="624px">
    <mj-include path="../_partials/header.mjml" />
    <mj-section padding="0 32px" background-color="#f4f4f5">
      <mj-column background-color="#ffffff" padding="32px 32px 16px">
        <mj-text>Click the button to sign in to Redaction Tools:</mj-text>
        <mj-button href="{{ link }}" background-color="#18181b" color="#ffffff" font-size="15px" border-radius="6px" align="left" padding="8px 0 16px">Sign in</mj-button>
        <mj-text>Or enter this code on the sign-in page:</mj-text>
        <mj-text font-size="28px" font-weight="600" letter-spacing="6px" font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" padding="0 0 24px">{{ code }}</mj-text>
        <mj-text>The link and the code expire in {{ ttl_minutes }} minutes, and either one works once. If you did not ask to sign in, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="../_partials/footer.mjml" />
  </mj-body>
</mjml>
