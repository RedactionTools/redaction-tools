    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.13",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.434.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
