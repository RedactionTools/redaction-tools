# Copy to frontend/.env.local for running Next.js outside Docker (bun run dev).
# The Docker Compose stack reads the repo-root .env instead.

# --- API ------------------------------------------------------------------
# Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8007
# Server-side origin; defaults to NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=http://backend:8007

# --- Site -----------------------------------------------------------------
# The public origin. Used for metadataBase, the sitemap and JSON-LD @ids, so
# it must be the canonical host in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# --- PostHog --------------------------------------------------------------
# Public client-side analytics configuration.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- NextAuth -------------------------------------------------------------
AUTH_URL=http://localhost:3007
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# The same Google OAuth client the backend uses (GOOGLE_CLIENT_ID/SECRET):
# allauth validates the id_token audience against its configured client id.
# Authorized redirect URI: http://localhost:3007/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
