# Site blocks for redaction-tools.com, to append to the Caddyfile of the stack
# that owns the `redactionnet` network (pdf-redaction). That Caddy already
# terminates TLS and holds :80/:443; this repo's containers join the same
# network so it can reach them by service name.
#
# Requires, in docker-compose-prod.yml: `backend` and `frontend` on the
# `redactionnet` network, where they carry the aliases used below. The bare
# service names are not used on purpose - `backend` and `frontend` are too
# generic for a network several stacks share. For the same reason `db`,
# `migrate` and `qcluster` stay off it entirely: pdf-redaction has a `db` too.
# `backend` is on both networks regardless, so DATABASE_URL names the alias
# `redaction-tools-db` rather than `db`, which would resolve to either one.
#
# The global block (acme_ca, email) already exists in that Caddyfile - do not
# add a second one.

# Redirect www -> apex (301, preserves path + query) to avoid a duplicate host.
www.redaction-tools.com {
    redir https://redaction-tools.com{uri} permanent
}

# --- Next.js: the public site ---------------------------------------------
redaction-tools.com {

    encode zstd gzip

    reverse_proxy redaction-tools-frontend:3007 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Hashed filenames, so these are safe to cache hard.
    @immutable path /_next/static/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# --- Django: API and admin -------------------------------------------------
# On its own host, so neither side needs path matching. Note this means browser
# calls to the API are cross-origin: CORS_ALLOWED_ORIGINS must list the apex.
# Server-rendered requests do not come through here at all - they go direct to
# backend:8007 over the compose network via API_INTERNAL_URL.
backend.redaction-tools.com {

    encode zstd gzip

    reverse_proxy redaction-tools-backend:8007 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        # Load-bearing: production.py sets SECURE_PROXY_SSL_HEADER and
        # SECURE_SSL_REDIRECT, so without this Django believes every request
        # is plain HTTP and redirects forever.
        header_up X-Forwarded-Proto {scheme}
    }

    @immutable path /static/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}
